APP_NAME=Talha Inventory API
DEBUG=true
# PostgreSQL (recommended) — start with: docker compose up -d db
# Default maps host port 5433 → container 5432 (avoids clash with local Postgres)
DATABASE_URL=postgresql+psycopg://talha:talha@localhost:5433/talha_inventory

# SQLite fallback (local file DB):
# DATABASE_URL=sqlite:///./talha_inventory.db
